{
  "name": "@threadsofgold/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "types": "./src/generated/models/index.ts",
      "default": "./dist/generated/models/index.js"
    }
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@threadsofgold/eslint-config": "workspace:*",
    "@threadsofgold/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "9.39.5",
    "orval": "8.27.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
