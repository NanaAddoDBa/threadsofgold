{
  "name": "@threadsofgold/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./src/admin.ts",
      "default": "./dist/admin.js"
    },
    "./api": {
      "types": "./src/api.ts",
      "default": "./dist/api.js"
    },
    "./observability": {
      "types": "./src/observability.ts",
      "default": "./dist/observability.js"
    },
    "./storefront": {
      "types": "./src/storefront.ts",
      "default": "./dist/storefront.js"
    },
    "./worker": {
      "types": "./src/worker.ts",
      "default": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@threadsofgold/eslint-config": "workspace:*",
    "@threadsofgold/typescript-config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
