{
  "name": "@threadsofgold/test-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./containers/postgresql": {
      "types": "./src/containers/postgresql.ts",
      "default": "./dist/containers/postgresql.js"
    },
    "./containers/redis": {
      "types": "./src/containers/redis.ts",
      "default": "./dist/containers/redis.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0"
  },
  "devDependencies": {
    "@threadsofgold/eslint-config": "workspace:*",
    "@threadsofgold/typescript-config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
