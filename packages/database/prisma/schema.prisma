generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

enum FoundationRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("foundation_request_status")
}

model FoundationRequest {
  id             String                  @id @db.Uuid
  idempotencyKey String                  @unique @map("idempotency_key") @db.VarChar(200)
  correlationId  String                  @map("correlation_id") @db.VarChar(36)
  status         FoundationRequestStatus @default(PENDING)
  attempts       Int                     @default(0)
  lastErrorType  String?                 @map("last_error_type") @db.VarChar(120)
  completedAt    DateTime?               @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("foundation_requests")
}
