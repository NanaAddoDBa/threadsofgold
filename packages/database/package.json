{
  "name": "@threadsofgold/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@threadsofgold/eslint-config": "workspace:*",
    "@threadsofgold/typescript-config": "workspace:*",
    "@types/pg": "8.15.5",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
