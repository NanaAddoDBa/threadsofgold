        "security": [],
        "summary": "Check whether the API can receive traffic",
        "tags": ["operations"]
      }
    },
    "/v1": {
      "get": {
        "operationId": "getServiceFoundation",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceFoundation"
                }
              }
            },
            "description": "Stable metadata for the current API foundation."
          }
        },
        "security": [],
        "summary": "Read the public API foundation metadata",
        "tags": ["foundation"]
      }
    },
    "/v1/foundation/requests": {
      "post": {
        "description": "Available only in local and test environments. It carries no customer, order, or payment data.",
        "operationId": "createFoundationRequest",
        "parameters": [
          {
            "description": "Stable retry key for this synthetic request.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoundationRequest"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorResponse"
                }
              }
            },
            "description": "The idempotency key is invalid."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorResponse"
                }
              }
            },
            "description": "The local walking skeleton is disabled."
          }
        },
        "security": [],
        "summary": "Create an idempotent synthetic walking-skeleton request",
        "tags": ["foundation"]
      }
    },
    "/v1/foundation/requests/{id}": {
      "get": {
        "description": "Available only in local and test environments. It carries no customer, order, or payment data.",
        "operationId": "getFoundationRequest",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoundationRequest"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorResponse"
                }
              }
            },
            "description": "The request identifier is invalid."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorResponse"
                }
              }
            },
            "description": "The request or local runtime is unavailable."
          }
        },
        "security": [],
        "summary": "Read a synthetic walking-skeleton request",
        "tags": ["foundation"]
      }
    },
    "/version": {
      "get": {
        "operationId": "getApiVersion",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "environment": {
                      "example": "local",
                      "type": "string"
                    },
                    "release": {
                      "example": "local",
                      "type": "string"
                    },
                    "service": {
                      "example": "threads-of-gold-api",
                      "type": "string"
                    },
                    "version": {
                      "example": "0.1.0",
                      "type": "string"
                    }
                  },
                  "required": ["environment", "release", "service", "version"],
                  "type": "object"
                }
              }
            },
            "description": ""
          }
        },
        "security": [],
        "summary": "Read the deployed API version",
        "tags": ["operations"]
      }
    }
  },
  "servers": [
