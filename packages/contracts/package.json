{
  "name": "@threadsofgold/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./src/service.ts",
      "default": "./dist/service.js"
    },
    "./openapi": {
      "types": "./src/openapi.ts",
      "default": "./dist/openapi.js"
    },
    "./foundation-request": {
      "types": "./src/foundation-request.ts",
      "default": "./dist/foundation-request.js"
    },
    "./http-error": {
      "types": "./src/http-error.ts",
      "default": "./dist/http-error.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@threadsofgold/eslint-config": "workspace:*",
    "@threadsofgold/typescript-config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
