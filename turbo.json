{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "strict",
  "globalDependencies": [
    ".prettierrc.json",
    "packages/eslint-config/*.mjs",
    "packages/typescript-config/*.json"
  ],
  "globalPassThroughEnv": ["CI", "NEXT_TELEMETRY_DISABLED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    }
  }
}
