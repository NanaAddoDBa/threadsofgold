{
  "name": "threadsofgold",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@threadsofgold/storefront",
    "dev:storefront": "pnpm --filter @threadsofgold/storefront dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck build"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "2.10.12"
  }
}
