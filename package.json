{
  "name": "threadsofgold",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@threadsofgold/storefront",
    "dev:storefront": "turbo run dev --filter=@threadsofgold/storefront",
    "dev:admin": "turbo run dev --filter=@threadsofgold/admin",
    "dev:api": "turbo run dev --filter=@threadsofgold/api",
    "dev:worker": "turbo run dev --filter=@threadsofgold/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.12"
  }
}
