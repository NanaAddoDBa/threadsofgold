# Deployment stage; never use NODE_ENV for staging.
APP_ENV=local
APP_RELEASE=local
FOUNDATION_RUNTIME_ENABLED=true
FOUNDATION_VERIFIER_TOKEN=replace-with-random-local-verifier-token
INTERNAL_API_URL=http://127.0.0.1:4000

# Public and embedded in the browser bundle during next build.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
