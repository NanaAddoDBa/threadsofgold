{
  "name": "@threadsofgold/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "openapi:generate": "pnpm --filter @threadsofgold/database generate && pnpm --filter @threadsofgold/config build && pnpm --filter @threadsofgold/contracts build && pnpm --filter @threadsofgold/database build && pnpm --filter @threadsofgold/observability build && tsx src/generate-openapi.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@threadsofgold/config": "workspace:*",
    "@threadsofgold/contracts": "workspace:*",
    "@threadsofgold/database": "workspace:*",
    "@threadsofgold/observability": "workspace:*",
    "bullmq": "6.3.2",
    "dotenv": "17.4.2",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@threadsofgold/eslint-config": "workspace:*",
    "@threadsofgold/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
