# Local dependency ports. Every published port is bound to 127.0.0.1.
TOG_POSTGRES_PORT=5432
TOG_REDIS_PORT=6379
TOG_SMTP_PORT=1025
TOG_MAILPIT_UI_PORT=8025
TOG_PAYSTACK_PORT=8089

# These credentials are deliberately local-only and must never be reused.
TOG_POSTGRES_DB=threadsofgold
TOG_POSTGRES_USER=threadsofgold
TOG_POSTGRES_PASSWORD=local-development-only
TOG_REDIS_PASSWORD=local-development-only
